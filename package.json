{
  "name": "react-image-morph",
  "version": "0.1.0",
  "description": "Drop two images, get a buttery crossfade/morph on scroll or hover. Pure CSS + a tiny controller. Zero deps.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "dev": "vite --config vite.site.config.ts",
    "build:demo": "vite build",
    "build:site": "vite build --config vite.site.config.ts",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "build": "npm run build:lib",
    "preview": "vite preview --config vite.site.config.ts"
  },
  "keywords": [
    "react",
    "image",
    "morph",
    "crossfade",
    "scroll",
    "hover",
    "animation",
    "motion"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}